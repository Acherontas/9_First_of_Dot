#include <iostream>
#include <string>
#include <iomanip>
#include <math.h>
#include <sstream>
#include <thread>
#include "sum_cdi.h"
using namespace std;

    long long int ar[10]={9,99,999,9999,99999,999999,9999999,99999999,999999999,9999999999};
    long long int nmb=0;
    long long int dft=9;
    int preci=0;
    int optn=0;
    int rgn=0;
    long long int argn_st=0;
    long long int argn_ed=0;
    int space_of=0;
    int ska=0;
    int arska[10],arka=0,fil=0;
    int sks=0;
    string fnd;
    long double rst=0;
    string st;

int lp(long long int dft){
     rst=0;
     fnd.clear();
     rst=(long double)nmb/(long double)dft;
    cout<<std::setprecision(preci)<<nmb << " / " << std::setprecision(preci) << dft << " ::== " << std::setprecision(preci) <<rst <<"\n";
    stringstream amk;
    amk<<std::setprecision(preci)<<rst ;
    string smlk;
    smlk.clear();
    smlk+=amk.str();
    cout<<"as String " << smlk <<"\n";
    char mk;
    int lk=0;
    int idx=0;
    for(int i=0;i<=smlk.size()-1;i++){
        mk=smlk.at(i);
        if(mk=='.'){idx=i;}
        if(idx!=0){break;}
    }
    if(idx!=0){
                mk=smlk.at(idx+1);
                lk=stoi(&mk);
                cout<<"@idx " << idx << " value of " << lk <<"\n";
    }

    if(idx==0){
     lk=0;
     cout<<"@idx value is 0 \n";
    }
    sum_cdi *dcms= new sum_cdi();
    dcms->cld=0;
    int dc=0;
    dc=dcms->cdis(nmb,0);
    if(lk==dc){
               rgn=0;
               fnd+=" SAME @ ";
               fnd+=to_string(dft);
               rgn=dft;

              if(fil==0){
               arska[arka]=dft;
               arka+=1;
               }

              }
    if(lk!=dc && lk!=0){fnd.clear(); fnd+=" Not Found "; goto A;}
    if(lk!=dc && lk==0 && dc==9){fnd.clear(); fnd+=" Full Range "; goto A;}
    if(lk!=dc && lk==0){fnd.clear(); fnd+=" Not Found "; goto A;}
    A:cout<<"for number " << std::setprecision(preci) <<nmb << " sum of digit ::== " << dc <<" " << fnd <<"\n";
    if(ska==0){
         st+="\n";
         //st+="-----------------------------------------------";
         //st+="\n";
         st+=to_string(nmb);
         st+=" '/' ";
         st+=to_string(dft);
         st+=" '::==' ";
         st+=to_string(rst);
         st+=" ";
         st+="@idx value : " ;
         st+=to_string(lk);
         st+=" with sum of digit : ";
         st+=to_string(dc);
         st+=" ";
         st+=fnd;
         //st+="------------------------------------------------";
         st+="\n";
    }
  return 0;
}


int main(int argc,char** argv)
{
    cout<<"voyeristic behaviours and others have fun\n";
    cout<<"enter ur number , press 0 for default or 1 to enter ur value ,2 to automate it , precision ,  \n";
    cout<<"enter 0 for range in the found [9]! or 1 to exit range start number , range end number \n";

    nmb=stoll(argv[1]);
    optn=stoi(argv[2]);
    preci=stoi(argv[3]);
    ska=stoi(argv[4]);
    argn_st=stoll(argv[5]);
    argn_ed=stoll(argv[6]);
    if(optn==0){lp(dft);}
    if(optn==1){cout<<"enter ur new default based on 9 or 99 or 9999 \n"; cin>>dft; lp(dft);}
    if(optn==2){
       for(int i=0;i<=9;i++){
           cout<<"----------------\n";
           lp(ar[i]);
           cout<<"----------------\n";
           std::this_thread::sleep_for(std::chrono::milliseconds(500));
       }
    }
    cout<<"\n";
    if(ska==0){
       fil=1;
       st.clear();
       space_of=argn_ed-argn_st;
          cout<<"---------\n";
          if(arka==0){
                   for(int i=0;i<=space_of;i++){
                        nmb=argn_st+i;
                        lp(rgn);
                     }
                     }
          if(arka>0){
                   // sks=0;sks=nmb;nmb=sks;
                    cout<<" -----> Multiple Values matches the criteria u want to prove. If you want salat(d) you can go and eat\n";
                           for(int k=0;k<=arka-1;k++){
                                               //sks=0;
                                               st.clear();
                                               cout<<" ----> using value of " <<arska[k] <<"\n";
                                               for(int j=0;j<=space_of;j++){
                                                        nmb=argn_st+j;
                                                        
                                                        lp(arska[k]);
                                                        cout<<" end of "<< arska[k] <<"\n";
                                                      }
                                                      
                                                cout<<st <<"\n";
                                                
                           }
                           
                    }
          cout<<"---------\n";
    }
    return 0;
}
